## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Xx]64/
[Xx]86/
[Bb]uild/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio code style
.vscode/

# Compiled executables in Binaries folder
# Windows executables
Binaries/*.exe
# Linux executables (no extension)
Binaries/Example[0-9]*
# macOS executables and bundles
Binaries/*.app
# ANGLE runtime DLLs copied next to the executables
Binaries/*.dll

# CMake build artifacts
CMakeCache.txt
cmake_install.cmake
*.sln
*.vcxproj
*.vcxproj.filters
**CMakeFiles
lib/
_deps/
